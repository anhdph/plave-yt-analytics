# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Supabase Session pooler (port 5432), copy exact string from Dashboard -> Connect
DATABASE_URL=postgresql+psycopg://postgres.<project_ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
